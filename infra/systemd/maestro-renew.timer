# Remote Control sessions get archived after a while; restarting daily at 05:00 (before the day
# starts) keeps the same session name available on every device.
[Unit]
Description=Maestro - renew the session daily at 05:00 Brasilia time

[Timer]
OnCalendar=*-*-* 05:00:00 America/Sao_Paulo
Persistent=false

[Install]
WantedBy=timers.target
